{
  "dependencies": {
    "body-parser": "^1.20.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.12.0",
    "sequelize": "^6.37.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  },
  "name": "url-shortener-app",
  "version": "1.0.0",
  "description": "app to short the urls",
  "main": "app.js",
  "scripts": {
    "test": "nodemon server.js",
    "start": "node server.js",
    "db:migration:gen": "sequelize-cli migration:generate --name",
    "db:seeder:gen": "sequelize-cli seed:generate --name",
    "db:migration:run": "node utils/connectSql.js && npx sequelize-cli db:migrate --env production && node utils/disconnectSql.js",
    "db:seeder:run": "node utils/connectSql.js && npx sequelize-cli db:seed:all --env production && node utils/disconnectSql.js"
  },
  "author": "Gurivelli Satish",
  "license": "ISC"
}
